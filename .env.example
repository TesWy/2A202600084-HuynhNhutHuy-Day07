# Embedding provider selection for manual experiments
# EMBEDDING_PROVIDER=mock
# EMBEDDING_PROVIDER=local
# EMBEDDING_PROVIDER=openai
# EMBEDDING_PROVIDER=gemini

# Optional: set cache directories for the local all-MiniLM-L6-v2 embedder
# HF_HOME=./.hf-cache
# SENTENCE_TRANSFORMERS_HOME=./.sentence-transformers

# Optional: OpenAI embedding configuration
# OPENAI_API_KEY=your-key-here
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional: Gemini / Google AI Studio embedding configuration
# GEMINI_API_KEY=your-ai-studio-key-here
# Or use GOOGLE_API_KEY if you already store Google API keys that way
# GOOGLE_API_KEY=your-ai-studio-key-here
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# GEMINI_CHAT_MODEL=gemma-4-31b-it

# Optional: for ChromaDB persistence (bonus task)
# CHROMA_PERSIST_DIR=./chroma_data
